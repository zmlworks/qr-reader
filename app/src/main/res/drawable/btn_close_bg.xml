<?xml version="1.0" encoding="utf-8"?>
<!-- the scanner's ×: dark rounded square with an amber frame (stands out on any camera image) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#66FF9A3C">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A6000000" />
            <stroke android:width="2.5dp" android:color="#FFFF9A3C" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
