<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/TopBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/IconBtn"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/title"
            style="@style/TopTitle"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <ImageButton
            android:id="@+id/btn_name"
            style="@style/IconBtn"
            android:contentDescription="@string/rename"
            android:src="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/btn_fav"
            style="@style/IconBtn"
            android:contentDescription="@string/favorite"
            android:src="@drawable/ic_star" />

        <ImageButton
            android:id="@+id/btn_delete"
            style="@style/IconBtn"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:lineSpacingExtra="3dp"
                android:padding="18dp"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:lineSpacingExtra="4dp"
                android:padding="18dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- one action per row; type-specific rows (call, mail, map, Wi-Fi) are added on top in code -->
            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:divider="@drawable/row_divider"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/act_share"
                    style="@style/ActionRow"
                    android:drawableStart="@drawable/ic_share"
                    android:text="@string/share_text" />

                <TextView
                    android:id="@+id/act_copy"
                    style="@style/ActionRow"
                    android:drawableStart="@drawable/ic_copy"
                    android:text="@string/copy_clipboard" />

                <TextView
                    android:id="@+id/act_search"
                    style="@style/ActionRow"
                    android:drawableStart="@drawable/ic_search"
                    android:text="@string/search_web" />

                <TextView
                    android:id="@+id/act_qr"
                    style="@style/ActionRow"
                    android:drawableStart="@drawable/ic_qr"
                    android:text="@string/create_this_qr" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/snackbar" />
</LinearLayout>
