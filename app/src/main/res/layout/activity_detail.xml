<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/TopBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/IconBtn"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/title"
            style="@style/TopTitle"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <com.zmlworks.qrreader.UnlockPill
            android:id="@+id/unlock_pill"
            style="@style/UnlockPill"
            android:tag="compact" />

        <ImageButton
            android:id="@+id/btn_lock"
            style="@style/IconBtn"
            android:contentDescription="@string/protect"
            android:src="@drawable/ic_lock" />

        <ImageButton
            android:id="@+id/btn_name"
            style="@style/IconBtn"
            android:contentDescription="@string/rename"
            android:src="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/btn_fav"
            style="@style/IconBtn"
            android:contentDescription="@string/favorite"
            android:src="@drawable/ic_star" />

        <ImageButton
            android:id="@+id/btn_delete"
            style="@style/IconBtn"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <!-- a code made on the Create page: its QR code first -->
            <com.zmlworks.qrreader.QrView
                android:id="@+id/detail_qr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/created_qr"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:lineSpacingExtra="3dp"
                android:padding="18dp"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <!-- copy, right under the content (no longer one of the action rows) -->
            <TextView
                android:id="@+id/act_copy"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_copy_small"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/copy"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/card_bg"
                android:lineSpacingExtra="4dp"
                android:padding="18dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- one action per row; type-specific rows (call, mail, map, Wi-Fi) are added on top in code -->
            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:divider="@drawable/row_divider"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/act_share"
                    style="@style/ActionRow"
                    android:drawableStart="@drawable/ic_share"
                    android:text="@string/share_text" />

                <TextView
                    android:id="@+id/act_search"
                    style="@style/ActionRow"
                    android:drawableStart="@drawable/ic_search"
                    android:text="@string/search_web" />

                <TextView
                    android:id="@+id/act_qr"
                    style="@style/ActionRow"
                    android:drawableStart="@drawable/ic_qr"
                    android:text="@string/create_this_qr" />
            </LinearLayout>

            <!-- memo: saved as you type -->
            <TextView
                android:id="@+id/memo_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp"
                android:text="@string/memo"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/memo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:gravity="top|start"
                android:hint="@string/memo_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="120dp"
                android:padding="16dp"
                android:textColor="@color/text"
                android:textColorHint="@color/dim"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <!-- a protected item before authentication -->
    <LinearLayout
        android:id="@+id/locked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock_filled" />

        <TextView
            android:id="@+id/locked_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/protected_item"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btn_unlock"
            style="@style/UnlockButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/unlock" />
    </LinearLayout>
    </FrameLayout>

    <include layout="@layout/snackbar" />
</LinearLayout>
