<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/TopBar">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/IconBtn"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/title"
            style="@style/TopTitle"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <ImageButton
            android:id="@+id/btn_fav"
            style="@style/IconBtn"
            android:contentDescription="@string/favorite"
            android:src="@drawable/ic_star" />

        <ImageButton
            android:id="@+id/btn_delete"
            style="@style/IconBtn"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:lineSpacingExtra="3dp"
                android:padding="18dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:lineSpacingExtra="4dp"
                android:padding="18dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/primary"
            style="@style/Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_open"
            android:visibility="gone" />

        <Button
            android:id="@+id/secondary"
            style="@style/Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_copy"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/act_copy"
                style="@style/ActionBtn"
                android:drawableTop="@drawable/ic_copy"
                android:text="@string/copy" />

            <TextView
                android:id="@+id/act_share"
                style="@style/ActionBtn"
                android:drawableTop="@drawable/ic_share"
                android:text="@string/share" />

            <TextView
                android:id="@+id/act_search"
                style="@style/ActionBtn"
                android:drawableTop="@drawable/ic_search"
                android:text="@string/search" />

            <TextView
                android:id="@+id/act_qr"
                style="@style/ActionBtn"
                android:drawableTop="@drawable/ic_qr"
                android:text="@string/create_qr" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/snackbar" />
</LinearLayout>
