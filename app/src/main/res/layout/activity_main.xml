<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top_bar"
        style="@style/TopBar">

        <TextView
            android:id="@+id/title"
            style="@style/TopTitle"
            android:text="@string/history" />

        <com.zmlworks.qrreader.UnlockPill
            android:id="@+id/unlock_pill"
            style="@style/UnlockPill" />

        <ImageButton
            android:id="@+id/btn_jump"
            style="@style/IconBtn"
            android:contentDescription="@string/jump_to_date"
            android:src="@drawable/ic_calendar" />

        <ImageButton
            android:id="@+id/btn_scan_top"
            style="@style/IconBtn"
            android:contentDescription="@string/scan"
            android:src="@drawable/ic_scan" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/page_history"
            layout="@layout/page_history" />

        <include
            android:id="@+id/page_create"
            layout="@layout/page_create"
            android:visibility="gone" />

        <include
            android:id="@+id/page_settings"
            layout="@layout/page_settings"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <include layout="@layout/snackbar" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/tab_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_history"
            style="@style/Tab"
            android:drawableTop="@drawable/ic_history"
            android:text="@string/history" />

        <TextView
            android:id="@+id/tab_create"
            style="@style/Tab"
            android:drawableTop="@drawable/ic_create"
            android:text="@string/create" />

        <TextView
            android:id="@+id/tab_settings"
            style="@style/Tab"
            android:drawableTop="@drawable/ic_settings"
            android:text="@string/settings" />
    </LinearLayout>
</LinearLayout>
