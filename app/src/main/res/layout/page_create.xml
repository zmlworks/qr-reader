<?xml version="1.0" encoding="utf-8"?>
<!-- QR square fixed at the top, a small "Save to history" text button, then the input (CreateLayout sizes the square to what is left). Always dark. -->
<com.zmlworks.qrreader.CreateLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/create_bg"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/qr_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/create_card_bg"
        android:contentDescription="@string/brightness_toggle"
        android:focusable="true">

        <com.zmlworks.qrreader.QrView
            android:id="@+id/qr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/create" />

        <!-- only shown when the text is too long for one QR -->
        <TextView
            android:id="@+id/qr_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/too_long"
            android:textColor="@color/create_dim"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- "Brightness max / normal" for about a second after a tap on the QR -->
        <TextView
            android:id="@+id/qr_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/pill_bg"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- small and text-like on purpose: adds the current text to History as a "Created" item -->
    <TextView
        android:id="@+id/save_history"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/save_to_history"
        android:textColor="@color/create_save"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:background="@drawable/create_input_bg"
        android:hint="@string/create_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:maxLines="4"
        android:minHeight="52dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:textColor="@color/create_text"
        android:textColorHint="@color/create_dim"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/qr_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/create_dim"
        android:textSize="12sp" />
</com.zmlworks.qrreader.CreateLayout>
