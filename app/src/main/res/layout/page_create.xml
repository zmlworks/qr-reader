<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.zmlworks.qrreader.QrView
            android:id="@+id/qr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/create" />

        <TextView
            android:id="@+id/qr_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/create_empty"
            android:textColor="@color/dim"
            android:textSize="15sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/qr_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:textColor="@color/dim"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/qr_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/qr_share"
            style="@style/ActionBtn"
            android:drawableTop="@drawable/ic_share"
            android:text="@string/share_image" />

        <TextView
            android:id="@+id/qr_save"
            style="@style/ActionBtn"
            android:drawableTop="@drawable/ic_save"
            android:text="@string/save_image" />

        <TextView
            android:id="@+id/qr_copy"
            style="@style/ActionBtn"
            android:drawableTop="@drawable/ic_copy"
            android:text="@string/copy" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/input_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@null"
            android:hint="@string/create_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLines="5"
            android:minHeight="52dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/dim"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/input_clear"
            style="@style/IconBtn"
            android:contentDescription="@string/clear_text"
            android:src="@drawable/ic_clear" />
    </LinearLayout>
</LinearLayout>
