<?xml version="1.0" encoding="utf-8"?>
<!-- simple rows; on/off settings have a checkbox on the right -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Clear all history at the top; the checkboxes on the right decide about favorites / protected codes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- only the title (plus ~10 dp around it) opens "Delete all history?"; the rest of the row does nothing -->
            <LinearLayout
                android:id="@+id/set_clear_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/set_clear"
                    style="@style/SettingTitle"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:text="@string/clear_history"
                    android:textColor="@color/danger" />

                <TextView
                    android:id="@+id/clear_value"
                    style="@style/SettingSub"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <!-- what else Clear all history deletes: two lines, both off at every start -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/set_clear_fav"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/incl_favorites"
                        android:textColor="@color/dim"
                        android:textSize="13sp" />

                    <CheckBox
                        android:id="@+id/cb_clear_fav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/set_clear_prot"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/incl_protected"
                        android:textColor="@color/dim"
                        android:textSize="13sp" />

                    <CheckBox
                        android:id="@+id/cb_clear_prot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="@color/line" />

        <LinearLayout
            android:id="@+id/set_left"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/left_handed" />

            <CheckBox
                android:id="@+id/cb_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/set_vibrate"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/vibrate" />

            <CheckBox
                android:id="@+id/cb_vibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/set_dark"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/dark_mode" />

            <CheckBox
                android:id="@+id/cb_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- one line: tap cycles DD/MM/YYYY -> MM/DD/YYYY -> YYYY/MM/DD -->
        <LinearLayout
            android:id="@+id/set_date_format"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/date_format" />

            <TextView
                android:id="@+id/date_format_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                android:textColor="@color/dim"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/set_confirm"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/confirm_browser" />

            <CheckBox
                android:id="@+id/cb_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/set_engine"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/search_engine" />
    
                <TextView
                    android:id="@+id/engine_value"
                    style="@style/SettingSub" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/line" />

        <!-- hidden extra: one scanning session that reads every barcode format -->
        <!-- the row keeps its place and height; only the centred text (plus ~10 dp around it) is tappable -->
        <FrameLayout
            android:id="@+id/set_once_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp">

            <TextView
                android:id="@+id/set_once"
                style="@style/SettingTitle"
                android:layout_gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:text="@string/once" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/set_about"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/about" />
    
                <TextView
                    android:id="@+id/about_value"
                    style="@style/SettingSub" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
