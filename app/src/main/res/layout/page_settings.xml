<?xml version="1.0" encoding="utf-8"?>
<!-- simple rows; on/off settings have a checkbox on the right -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/set_left"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/left_handed" />

            <CheckBox
                android:id="@+id/cb_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/set_vibrate"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/vibrate" />

            <CheckBox
                android:id="@+id/cb_vibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/set_dark"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/dark_mode" />

            <CheckBox
                android:id="@+id/cb_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/set_confirm"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/confirm_browser" />

            <CheckBox
                android:id="@+id/cb_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/set_engine"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/search_engine" />
    
                <TextView
                    android:id="@+id/engine_value"
                    style="@style/SettingSub" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/line" />

        <LinearLayout
            android:id="@+id/set_clear"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/clear_history"
                    android:textColor="@color/danger" />
    
                <TextView
                    android:id="@+id/clear_value"
                    style="@style/SettingSub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/set_about"
            style="@style/SettingRow"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/about" />
    
                <TextView
                    android:id="@+id/about_value"
                    style="@style/SettingSub" />
            </LinearLayout>
        </LinearLayout>

        <!-- hidden all-codes mode -->
        <TextView
            android:id="@+id/set_once"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/once"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>
</ScrollView>
